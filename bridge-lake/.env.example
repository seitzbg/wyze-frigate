# Copy to .env and fill in. Never commit .env.
# The same Wyze account as bridge/.env: two bridges can share one login.

WYZE_EMAIL=
WYZE_PASSWORD=
# API ID and key from https://developer-api-console.wyze.com/#/apikey/view
WYZE_API_ID=
WYZE_API_KEY=
# Only for accounts with two-factor auth through an authenticator app.
# WYZE_TOTP_KEY=

TZ=UTC

# Login for the web UI and REST API on port 5081 (HTTP basic auth).
# Set a real password: when it is empty the bridge uses the part of
# WYZE_EMAIL before the @.
BRIDGE_AUTH=true
BRIDGE_USERNAME=wyze
BRIDGE_PASSWORD=

# Login for RTSP (port 8556) as user:password, required: Docker publishes
# that port on every interface, outside the host firewall, and the compose
# file refuses to start while this is empty. Put the same value in
# Frigate's .env as FRIGATE_LAKE_AUTH for the camera's input URL.
STREAM_AUTH=
