# Copy to .env and fill in. Never commit .env.

# Wyze account email and password. If you sign in with Google or Apple, set
# a Wyze password for the account first. The bridge cannot use SSO.
WYZE_EMAIL=
WYZE_PASSWORD=
# API ID and key from https://developer-api-console.wyze.com/#/apikey/view
WYZE_API_ID=
WYZE_API_KEY=
# Only for accounts with two-factor auth through an authenticator app.
# WYZE_TOTP_KEY=

# This host's LAN IP, offered to browsers for WebRTC playback.
BRIDGE_IP=
TZ=UTC

# Login for the web UI and REST API on port 5080 (HTTP basic auth).
# Set a real password: when it is empty the bridge uses the part of
# WYZE_EMAIL before the @.
BRIDGE_AUTH=true
BRIDGE_USERNAME=wyze
BRIDGE_PASSWORD=

# Optional login for RTSP (port 8554) only. If you set it, put the same user
# and password in Frigate's input URLs. Port 1984 stays open either way; see
# docs/network-and-security.md. Not tested by this repo.
# STREAM_AUTH=viewer:change-me
