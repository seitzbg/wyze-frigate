# LAN IP of the host running the bridge (it uses host networking).
FRIGATE_BRIDGE_IP=
# Only with the Bulb Cam Pan bridge (docs/bulb-cam-pan.md): its RTSP login,
# the STREAM_AUTH value from bridge-lake/.env, for {FRIGATE_LAKE_AUTH} in
# the camera's input URL.
# FRIGATE_LAKE_AUTH=viewer:change-me
TZ=UTC
